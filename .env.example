# Copy to .env and add your PAPER account credentials. Never commit this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# demo: deterministic synthetic data; alpaca: live market data from Alpaca.
MARKET_DATA_MODE=alpaca

# Safety lock. CLI submission additionally requires the runner's --execute flag.
ENABLE_PAPER_ORDERS=false
# Position budget: 1% of modeled equity, never above $1,000. Defensive and
# lower-conviction exploration signals use the $500 half-size cap.
ACCOUNT_EQUITY=100000
MAX_RISK_PER_TRADE_PCT=0.01
MAX_POSITION_LOSS_DOLLARS=1000
DEFENSIVE_RISK_CAP_DOLLARS=500
# Scheduled managed exits trigger when unrealized loss reaches 50% of debit.
STOP_LOSS_FRACTION=0.50
# Portfolio circuit breakers for autonomous entries.
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_SPREADS=3
# Separate lock for 55–60% exploration signals.
ENABLE_EXPLORATION_ORDERS=false
# Manual dashboard MLeg orders need both this lock and a private operator token.
ENABLE_MANUAL_PAPER_ORDERS=false
MANUAL_TRADE_TOKEN=
ALPACA_MCP_ENABLED=false
ALPACA_CLI_ENABLED=false

# Optional GPT research agent. It receives only read-only Alpaca MCP tools and
# can advise the council; it never receives an order-submission tool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_GPT_MCP_RESEARCH=false

# Used by the official Alpaca MCP server. Keep this true for the hackathon.
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=assets,stock-data,options-data,news,corporate-actions

# Backend URL used by the Next.js server.
REGIMESHIFT_API_URL=http://127.0.0.1:8000
